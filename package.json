{
  "name": "another-react-tailwind-component-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --docs",
    "build-storybook": "storybook build --docs",
    "test": "vitest run --project=storybook",
    "prepare": "husky",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "classnames": "^2.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
